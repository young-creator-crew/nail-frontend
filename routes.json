      "RegisterRequestDTO": {
        "type": "object",
        "description": "Dados necessários para cadastrar um novo usuário.",
        "properties": {
          "name": {
            "type": "string",
            "description": "Nome do usuário.",
            "example": "Maria Silva",
            "maxLength": 100,
            "minLength": 0
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "E-mail que será utilizado para acessar a aplicação.",
