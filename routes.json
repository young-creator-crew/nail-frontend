            "example": 5,
            "minimum": 0
          },
          "confirmed": {
            "type": "integer",
            "format": "int64",
            "description": "Agendamentos atualmente com status CONFIRMADO.",
            "example": 3,
            "minimum": 0
          },
          "completed": {
            "type": "integer",
            "format": "int64",
            "description": "Agendamentos atualmente com status CONCLUIDO.",
            "example": 2,
            "minimum": 0
          },
          "cancelled": {
            "type": "integer",
            "format": "int64",
            "description": "Agendamentos atualmente com status CANCELADO.",
            "example": 1,
            "minimum": 0
          }
        }
      },
      "DashboardKpiResponseDTO": {
        "type": "object",
        "description": "Indicadores-chave de desempenho para o período selecionado.",
        "properties": {
          "totalAppointments": {
            "type": "integer",
            "format": "int64",
            "description": "Número total de agendamentos com início previsto dentro do período selecionado, independentemente do status.",
            "example": 128,
            "minimum": 0
          },
          "completedRevenue": {
            "type": "number",
            "description": "Soma dos valores dos agendamentos marcados atualmente como concluídos dentro do período selecionado.",
            "example": 8450,
            "minimum": 0
          },
          "cancellationRate": {
            "type": "number",
            "description": "Percentual de agendamentos no período selecionado que estão marcados como cancelados. Varia de 0 a 100 e é arredondado para duas casas decimais.",
            "example": 8.59,
            "maximum": 100,
            "minimum": 0
          }
        }
      },
      "DashboardResponseDTO": {
        "type": "object",
        "description": "Resumo do painel para um intervalo de datas selecionado.",
        "properties": {
          "startDate": {
            "type": "string",
            "format": "date",
            "description": "Data de início do período de referência.",
            "example": "2026-10-01"
          },
          "endDate": {
            "type": "string",
            "format": "date",
            "description": "Data de término do período de referência.",
            "example": "2026-10-31"
          },
          "kpis": {
            "$ref": "#/components/schemas/DashboardKpiResponseDTO",
            "description": "Indicadores-chave de desempenho para o período selecionado."
          },
          "appointmentsByDay": {
            "type": "array",
            "description": "Contagem diária de agendamentos, incluindo datas sem agendamentos.",
            "items": {
              "$ref": "#/components/schemas/AppointmentDailySummaryResponseDTO"
            }
          }
        }
      }
    }
  }
