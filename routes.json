            "maxLength": 255,
            "minLength": 0
          },
          "password": {
            "type": "string",
            "format": "password",
            "description": "Senha original, com no mínimo 8 e no máximo 128 caracteres.",
            "example": "Senha123!",
            "maxLength": 128,
            "minLength": 8,
            "writeOnly": true
          },
          "phone": {
            "type": [
              "string",
              "null"
            ],
            "description": "Telefone de contato. Campo opcional.",
            "example": "+5511999999999",
            "maxLength": 20,
            "minLength": 0
          }
        },
        "required": [
          "email",
          "name",
          "password"
        ]
      },
      "LoginRequestDTO": {
        "type": "object",
        "description": "Credenciais utilizadas para autenticar um usuário.",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "description": "E-mail cadastrado na aplicação.",
            "example": "maria@email.com",
            "maxLength": 255,
            "minLength": 0
          },
          "password": {
            "type": "string",
            "format": "password",
            "description": "Senha original do usuário. Será validada com o hash armazenado.",
            "example": "Senha123!",
            "maxLength": 128,
            "minLength": 0,
            "writeOnly": true
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "ServiceSummaryResponseDTO": {
        "type": "object",
        "description": "Dados de resposta resumidos para um serviço.",
        "properties": {
          "idNailService": {
            "type": "integer",
            "format": "int32",
            "description": "Identificador exclusivo do serviço.",
            "example": 1,
            "readOnly": true
          },
          "serviceName": {
            "type": "string",
            "description": "Nome do serviço.",
            "example": "Alongamento de unhas em gel"
          },
          "serviceDescription": {
            "type": [
              "string",
              "null"
            ],
            "description": "Descrição do serviço.",
            "example": "Alongamento de unhas com gel."
          },
          "photoUrl": {
            "type": [
              "string",
              "null"
            ],
            "description": "URL da foto do serviço.",
            "example": "/fotos/2f59a2d0.jpg"
          },
          "active": {
            "type": "boolean",
            "description": "Indica se o serviço está ativo.",
            "example": true
          }
        }
      },
      "AppointmentDailySummaryResponseDTO": {
        "type": "object",
        "description": "Contagem diária de agendamentos, agrupados por status atual.",
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "description": "Data representada por este ponto de dados.",
